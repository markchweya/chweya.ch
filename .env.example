# ---------------------------------------------------------------------------
# Dumi environment configuration
#
# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored and must never be committed.
#
# Every value here is a placeholder. None of them will work as written, which
# is deliberate: a missing or obviously fake value fails validation at startup
# rather than silently working in the wrong environment.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development           # development | test | production
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000

# Signs session cookies. Unique per deployment, never shared, never reused.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-48-random-url-safe-bytes

# --- Database --------------------------------------------------------------
# Self-hosted PostgreSQL. Do not point this at a managed database service.
# The password belongs here and nowhere else; it is never written in source.
DATABASE_URL=postgresql+psycopg://dumi:CHANGE_ME@localhost:5432/dumi
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Consumed by docker-compose to initialise the database container. Keep in
# step with the password inside DATABASE_URL.
POSTGRES_USER=dumi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dumi

# --- Redis, background jobs ------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Apertus ---------------------------------------------------------------
# Apertus is reached over an OpenAI-compatible chat completions API, which is
# what vLLM and Ollama both expose. Point APERTUS_BASE_URL at whichever you
# run. From inside Docker, the host is reachable as host.docker.internal; see
# docs/apertus.md.
#
#   vLLM   http://localhost:8000/v1
#   Ollama http://localhost:11434/v1
APERTUS_BASE_URL=http://localhost:8000/v1
APERTUS_MODEL=apertus
APERTUS_API_KEY=                  # leave empty when the local server needs no token
APERTUS_TIMEOUT_SECONDS=120
APERTUS_CONNECT_TIMEOUT_SECONDS=10
APERTUS_MAX_CONTEXT_TOKENS=8192
APERTUS_MAX_OUTPUT_TOKENS=1024
APERTUS_TEMPERATURE=0.2           # low on purpose: sampling shows up as invented fees
APERTUS_MAX_RETRIES=2
APERTUS_STREAM=true
APERTUS_HEALTH_TIMEOUT_SECONDS=5

# --- Embeddings ------------------------------------------------------------
# Runs locally. No externally hosted embedding service is permitted.
# Must cover German, English, French and Italian.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16

# --- Crawler ---------------------------------------------------------------
# Hostnames the crawler may contact. Anything else is refused before a socket
# is opened. Widening this list is a policy decision, see
# docs/crawler-policy.md.
#
# zg.ch is the Canton of Zug, zug.ch is the City of Zug. Both are included
# because the cantonal content lives on zg.ch and the names are easily
# confused.
CRAWLER_ALLOWED_HOSTS=www.zug.ch,zug.ch,www.zg.ch,zg.ch,www.uri.ch,uri.ch
CRAWLER_USER_AGENT=DumiBot/0.1 (unofficial prototype; +{contact})
# Required in production. A crawler that will not say who to contact
# should not be running against someone else's website.
CRAWLER_CONTACT=you@example.org
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_DEFAULT_DELAY_SECONDS=1.0
CRAWLER_MAX_RESPONSE_BYTES=26214400
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
CRAWLER_MAX_REDIRECTS=3
CRAWLER_MAX_PAGES_PER_RUN=5000
CRAWLER_RESPECT_ROBOTS=true

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=52428800
UPLOAD_STORAGE_PATH=./storage/uploads
UPLOAD_QUARANTINE_PATH=./storage/quarantine
# Integration point for a malware scanner, for example:
#   MALWARE_SCANNER_COMMAND=clamdscan --no-summary --stdout
# Empty disables scanning. Permitted in development, refused in production.
MALWARE_SCANNER_COMMAND=

# --- Privacy ---------------------------------------------------------------
# Transcripts are not stored by default. Answering a question does not require
# keeping it afterwards. Turning this on is a data protection decision and
# needs a documented legal basis and a retention period.
STORE_CHAT_TRANSCRIPTS=false
CHAT_RETENTION_DAYS=0
HASH_CLIENT_ADDRESSES=true

# --- Rate limiting and lockout ---------------------------------------------
RATE_LIMIT_CHAT_PER_MINUTE=12
RATE_LIMIT_LOGIN_PER_MINUTE=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# --- Sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=dumi_session
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Set false only for plain-HTTP local development. Refused in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- Administrator bootstrap -----------------------------------------------
# Used once by:  python -m app.cli bootstrap-admin
# The password is hashed with Argon2id at once and never stored in plaintext.
# The account is created with a forced password change on first login.
# Unset both after the administrator exists.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=

# --- Local database interface ----------------------------------------------
# Adminer is published on 127.0.0.1 only, never on 0.0.0.0. It has no
# credentials of its own; you sign in with the database user above.
ADMINER_BIND_ADDRESS=127.0.0.1
ADMINER_PORT=8081

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json in deployment, console when developing
